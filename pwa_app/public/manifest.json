{
    "name": "Krystaa",
    "short_name": "Krystaa",
    "description": "Unified PWA for RMA, Dispatch & HRMS",
    "start_url": "/install/app",
    "display": "standalone",
    "background_color": "#f7f9fb",
    "theme_color": "#004ac6",
    "orientation": "portrait",
    "icons": [
        {
            "src": "/assets/pwa_app/icons/icon-192.svg",
            "sizes": "192x192",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "/assets/pwa_app/icons/icon-512.svg",
            "sizes": "512x512",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        }
    ],
    "categories": ["business", "productivity"],
    "share_target": {
        "action": "/install/app",
        "method": "GET",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    }
}
