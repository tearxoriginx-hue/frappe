  "fields": [
    {
      "fieldname": "serial_no",
      "fieldtype": "Link",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Serial No",
      "options": "Serial No",
      "reqd": 1,
      "description": "Scan or type serial number to auto-fill details"
    },
    {
      "fetch_from": "serial_no.item_code",
      "fieldname": "item_code",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Item Code",
      "options": "Item",
      "read_only": 1
    },
    {
      "fetch_from": "serial_no.item_name",
      "fieldname": "item_name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Item Name",
      "read_only": 1
    },
    {
      "fetch_from": "serial_no.customer",
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer",
      "options": "Customer",
      "read_only": 1
    },
    {
      "fetch_from": "serial_no.branch",
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Branch",
      "read_only": 1,
      "reqd": 1
    },
    {
      "fetch_from": "serial_no.company",
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "read_only": 1,
      "reqd": 1
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "reqd": 1,
      "default": "Today",
      "read_only": 1
    },
    {
      "fieldname": "column_break_details",
      "fieldtype": "Column Break"
    },
    {
      "fetch_from": "serial_no.customer_name",
      "fieldname": "customer_name",
      "fieldtype": "Data",
      "label": "Customer Name",
      "read_only": 1
    },
    {
      "fieldname": "sale_date",
      "fieldtype": "Date",
      "in_list_view": 1,
      "label": "Sale Date",
      "read_only": 1
    },
    {
      "fetch_from": "serial_no.warranty_expiry_date",
      "fieldname": "warranty_expiry",
      "fieldtype": "Date",
      "in_list_view": 1,
      "label": "Warranty Expiry",
      "read_only": 1
    },
    {
      "fieldname": "warranty_status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Warranty Status",
      "options": "In Warranty\nOut of Warranty",
      "read_only": 1
    },
    {
      "fieldname": "warranty_days",
      "fieldtype": "Int",
      "label": "Warranty Period (Days)",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Status",
      "options": "Draft\nIn Repair\nCompleted\nPending Approval\nApproved for Replacement\nReplaced\nCancelled",
      "default": "Draft",
      "reqd": 1
    },
    {
      "fieldname": "section_break_rma",
      "fieldtype": "Section Break",
      "label": "RMA Details"
    },
    {
      "fieldname": "rma_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "RMA Type",
      "options": "\nRepair\nReplacement",
      "reqd": 1
    },
    {
      "fieldname": "column_break_rma",
      "fieldtype": "Column Break"
    },
    {
      "depends_on": "eval:doc.rma_type=='Repair'",
      "fieldname": "repair_notes",
      "fieldtype": "Small Text",
      "label": "Repair Notes",
      "description": "Describe the issue and repair performed"
    },
    {
      "depends_on": "eval:doc.rma_type=='Replacement'",
      "fieldname": "section_break_replacement",
      "fieldtype": "Section Break",
      "label": "Replacement Details"
    },
    {
      "depends_on": "eval:doc.warranty_status=='Out of Warranty' && doc.rma_type=='Replacement'",
      "fieldname": "buffer_warranty",
      "fieldtype": "Check",
      "label": "Buffer Warranty (Out of Warranty - Invoice Required)",
      "description": "Check this if customer is out of warranty but has an original invoice. Manager verification required."
    },
    {
      "depends_on": "eval:doc.buffer_warranty==1 && doc.rma_type=='Replacement'",
      "fieldname": "invoice_image",
      "fieldtype": "Attach Image",
      "label": "Invoice / Bill Image",
      "description": "Upload the customer's original purchase invoice/bill for manager verification",
      "reqd": 1
    },
    {
      "depends_on": "eval:doc.rma_type=='Replacement'",
      "fieldname": "invoice_verified",
      "fieldtype": "Check",
      "label": "Invoice Verified",
      "read_only": 1,
      "description": "Set by manager when invoice is verified"
    },
    {
      "depends_on": "eval:doc.rma_type=='Replacement'",
      "fieldname": "manager_verified_by",
      "fieldtype": "Link",
      "label": "Verified By",
      "options": "User",
      "read_only": 1
    },
    {
      "depends_on": "eval:doc.rma_type=='Replacement'",
      "fieldname": "column_break_replace",
      "fieldtype": "Column Break"
    },
    {
      "depends_on": "eval:doc.rma_type=='Replacement'",
      "fieldname": "replacement_serial_no",
      "fieldtype": "Link",
      "label": "Replacement Serial No",
      "options": "Serial No",
      "read_only": 1,
      "unique": 1
    },
    {
      "depends_on": "eval:doc.rma_type=='Replacement'",
      "fetch_from": "replacement_serial_no.item_code",
      "fieldname": "replacement_item_code",
      "fieldtype": "Data",
      "label": "Replacement Item Code",
      "read_only": 1
    },
    {
      "depends_on": "eval:doc.rma_type=='Replacement'",
      "fieldname": "replacement_dispatch_entry",
      "fieldtype": "Link",
      "label": "Replacement Dispatch Entry",
      "options": "Dispatch Entry",
      "read_only": 1
    },
    {
      "fieldname": "audit_log",
      "fieldtype": "Table",
      "label": "Audit Log",
      "options": "RMA Activity Log",
      "read_only": 1,
      "depends_on": "eval:doc.docstatus==1"
    },
    {
      "fieldname": "section_break_dates",
      "fieldtype": "Section Break",
      "label": "Completion"
    },
    {
      "fieldname": "completed_date",
      "fieldtype": "Datetime",
      "label": "Completed Date",
      "read_only": 1
    },
    {
      "fieldname": "is_archived",
      "fieldtype": "Check",
      "label": "Is Archived",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "no_copy": 1,
      "options": "RMA Request",
      "print_hide": 1,
      "read_only": 1
    }
  ],
