  "html": "<!-- ================= FRAPPE LETTERHEAD ================= -->\r\n{% if letter_head %}\r\n<div class=\"print-heading\" style=\"margin-bottom: 20px;\">\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n\r\n<!-- ================= MAIN DOCUMENT BODY ================= -->\r\n<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #222; padding: 10px 30px 30px 30px; font-size: 13px; line-height: 1.6;\">\r\n\r\n    <!-- ================= UPPER BOX ================= -->\r\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 40px;\">\r\n        <tr>\r\n            <!-- Left Side: Customer Info & Corporate Office -->\r\n            <td style=\"width: 60%; vertical-align: top;\">\r\n                <div style=\"font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px; color: #8c8c8c; margin-bottom: 4px; font-weight: 600;\">Customer Details</div>\r\n                <div style=\"font-size: 16px; font-weight: 700; color: #000; letter-spacing: -0.2px;\">{{ doc.customer_name or '' }}</div>\r\n                <div style=\"color: #666; font-size: 12px; margin-top: 2px;\">ID: {{ doc.customer or '' }}</div>\r\n                \r\n                <!-- Dynamic display if contact information is available -->\r\n                {% if doc.customer_phone or doc.customer_email %}\r\n                <div style=\"color: #666; font-size: 12px; margin-top: 1px;\">\r\n                    {{ doc.customer_phone or '' }} {% if doc.customer_email %}&bull; {{ doc.customer_email }}{% endif %}\r\n                </div>\r\n                {% endif %}\r\n                \r\n                <!-- Company Sub-Anchor -->\r\n                <div style=\"margin-top: 24px; border-top: 1px solid #f0f0f0; padding-top: 12px; width: 80%;\">\r\n                    <div style=\"font-size: 12px; font-weight: 700; color: #111; text-transform: uppercase; letter-spacing: 0.5px;\">{{ doc.company or '' }}</div>\r\n                    <div style=\"font-size: 11px; color: #777; margin-top: 1px;\">Branch Logistics: {{ doc.branch or '' }}</div>\r\n                </div>\r\n            </td>\r\n\r\n            <!-- Right Side: Voucher Status & Verification Metrics -->\r\n            <td style=\"width: 40%; vertical-align: top; text-align: right;\">\r\n                <div style=\"font-size: 13px; font-weight: 700; color: #000; text-transform: uppercase; letter-spacing: 1px;\">{{ doc.rma_type or 'Replacement' }} Voucher</div>\r\n                <div style=\"font-size: 12px; color: #000; margin-top: 3px; font-weight: 500;\">Status: <span style=\"font-weight: 700;\">{{ doc.status or '' }}</span></div>\r\n                <div style=\"color: #777; font-size: 11px; margin-top: 2px;\">Date Issued: {{ doc.posting_date or '' }}</div>\r\n\r\n                <!-- Warranty Status Box -->\r\n                <div style=\"margin-top: 24px; border-top: 1px solid #f0f0f0; padding-top: 12px; display: inline-block; text-align: right; min-width: 150px;\">\r\n                    <div style=\"font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px; color: #8c8c8c; margin-bottom: 3px; font-weight: 600;\">Warranty Verification</div>\r\n                    <div style=\"font-weight: 700; color: #166534; font-size: 12px;\">{{ doc.warranty_status or '' }}</div>\r\n                    <div style=\"color: #666; font-size: 11px; margin-top: 1px;\">Expires: {{ doc.warranty_expiry or '' }}</div>\r\n                </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ================= BELOW BOX: THE LINE ITEMS ================= -->\r\n    <div style=\"margin-top: 20px;\">\r\n        <table style=\"width: 100%; border-collapse: collapse; text-align: left;\">\r\n            <thead>\r\n                <tr style=\"border-bottom: 1px solid #111; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: #555;\">\r\n                    <th style=\"padding-bottom: 10px; font-weight: 700; width: 50%;\">Returned / Faulty Product</th>\r\n                    <th style=\"padding-bottom: 10px; font-weight: 700; width: 50%; padding-left: 20px;\">New Replacement Issued</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                <tr>\r\n                    <!-- Left Side: Old Product Details -->\r\n                    <td style=\"padding: 20px 20px 20px 0; vertical-align: top;\">\r\n                        <div style=\"font-size: 14px; font-weight: 700; color: #000;\">{{ doc.item_name or '' }}</div>\r\n                        <div style=\"font-size: 11px; color: #666; margin-top: 2px; letter-spacing: 0.3px;\">SKU / Code: {{ doc.item_code or '' }}</div>\r\n                        \r\n                        <div style=\"margin-top: 15px; font-size: 11px; color: #444;\">\r\n                            <span style=\"color: #8c8c8c; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; display: block; margin-bottom: 3px;\">Returned Serial Number</span>\r\n                            <span style=\"font-family: ui-monospace, SFMono-Regular, Courier, monospace; font-weight: 600; color: #333; background: #f5f5f5; padding: 3px 6px; border-radius: 4px; border: 1px solid #e8e8e8;\">\r\n                                {{ doc.serial_no or 'N/A' }}\r\n                            </span>\r\n                        </div>\r\n                    </td>\r\n                    \r\n                    <!-- Right Side: Clean Replacement Details -->\r\n                    <td style=\"padding: 20px 0 20px 20px; vertical-align: top; border-left: 1px solid #e8e8e8;\">\r\n                        <div style=\"font-size: 14px; font-weight: 700; color: #000;\">{{ doc.replacement_item_name or doc.item_name or '' }}</div>\r\n                        <div style=\"font-size: 11px; color: #666; margin-top: 2px; letter-spacing: 0.3px;\">SKU / Code: {{ doc.replacement_item_code or doc.item_code or '' }}</div>\r\n                        \r\n                        <div style=\"margin-top: 15px; font-size: 11px; color: #000;\">\r\n                            <span style=\"color: #8c8c8c; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; display: block; margin-bottom: 3px;\">Issued Serial Number</span>\r\n                            <span style=\"font-family: ui-monospace, SFMono-Regular, Courier, monospace; font-weight: 600; color: #166534; background: #f0fdf4; padding: 3px 6px; border-radius: 4px; border: 1px solid #dcfce7;\">\r\n                                {{ doc.replacement_serial_no or 'N/A' }}\r\n                            </span>\r\n                        </div>\r\n                    </td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n</div>\r\n\r\n<!-- ================= FRAPPE FOOTER ================= -->\r\n{% if footer %}\r\n<div class=\"print-footer\" style=\"margin-top: 30px;\">\r\n    {{ footer }}\r\n</div>\r\n{% endif %}",
